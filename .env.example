# Copia este archivo a .env (está fuera de git) y completa lo obligatorio.

# ── Obligatorio ──────────────────────────────────────────────────────────────
# Administrador de la empresa demo, ya registrada y verificada en Sentinel.
DEMO_SENTINEL_EMAIL=
DEMO_SENTINEL_PASSWORD=

# ── Opcional ─────────────────────────────────────────────────────────────────
# Con el Sentinel de Docker en esta máquina, usa el segundo archivo de compose
# (docker-compose.sentinel-local.yml) y no hace falta tocar estas dos.
# Sentinel en AWS: la URL de CloudFront, y como DEMO_PUBLIC_URL una dirección
# pública que Sentinel pueda abrir (hoy, un túnel).
#DEMO_SENTINEL_URL=http://host.docker.internal:8080
#DEMO_PUBLIC_URL=http://host.docker.internal:7000

# Usuarios por segundo con que arrancan las tres plataformas, en cuanto hay
# conexión con Sentinel. 0 las deja quietas hasta que las enciendas en la consola.
#DEMO_TRAFFIC_RPS=2

# Quién puede abrir los sitios. Por omisión solo esta máquina; con 0.0.0.0 los
# abren otros equipos o tablets de la misma red (y también la consola y la API
# de control, salvo que definas DEMO_CONSOLE_KEY).
#DEMO_BIND=127.0.0.1
#DEMO_PORT=7000

# Avisos de cada servicio fuera del correo; se activan al preparar el escenario.
#DEMO_DISCORD_WEBHOOK=
#DEMO_SLACK_WEBHOOK=

# Portal del cliente (F13). Con DEMO_PORTAL_PASSWORD (8 a 72 caracteres, la
# regla de Sentinel) se da acceso al primer contacto de cada plataforma y se
# activa su usuario. En local el contacto usa su correo de example.com y Mailpit
# lo captura. En aws DEMO_PORTAL_EMAIL es obligatoria y es una casilla real
# (equipo@dominio.cl): el contacto pasa a equipo+<plataforma>@dominio.cl.
#DEMO_PORTAL_PASSWORD=
#DEMO_PORTAL_EMAIL=
# Sitio del cliente de Sentinel, para el enlace «Abrir portal» de la consola.
#DEMO_SENTINEL_WEB_URL=http://localhost:5173

# ── Acceso (A6) ──────────────────────────────────────────────────────────────
# Con DEMO_CONSOLE_KEY, la consola, el Modo Director y la API de control piden
# esa clave en /acceso. DEMO_SITE_PASSWORD abre solo los sitios. /salud y
# /healthz quedan abiertas para el sondeo de Sentinel. Al menos 12 caracteres y
# distintas entre sí. En DEMO_PROFILE=aws son obligatorias: sin ellas no arranca.
# Para curl o scripts: cabecera «Authorization: Bearer <DEMO_CONSOLE_KEY>».
#DEMO_CONSOLE_KEY=
#DEMO_SITE_PASSWORD=

# ── Sentinel en producción (perfil aws) ──────────────────────────────────────
# Ventana de monitoreo de los tres proyectos, en UTC (Chile continental = UTC-3
# en verano). Fuera de ella Sentinel no sondea los proyectos. Vacía = 24/7.
#DEMO_MONITORING_WINDOW=12:00-23:00
# Intervalo del sondeo dentro de la ventana y fuera de ella, en segundos.
#DEMO_POLL_INTERVAL=5
#DEMO_POLL_INTERVAL_IDLE=30
# Correos por incidente: critica, alta, media, baja (y las más graves) u off.
# Vacío deja el canal correo como está en Sentinel.
#DEMO_EMAIL_MIN_SEVERITY=alta
